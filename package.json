{
  "name": "llmchat",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd apps/api && ./mvnw spring-boot:run",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "test:api": "cd apps/api && ./mvnw test"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
