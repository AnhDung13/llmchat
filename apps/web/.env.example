# Copy file này thành .env.local rồi sửa theo máy của bạn: cp .env.example .env.local
# .env.local không được commit (đã có trong .gitignore).

# Địa chỉ backend Spring Boot.
# Trình duyệt luôn gọi /api/... trên cùng origin với Vite (http://localhost:5173),
# Vite chuyển tiếp sang địa chỉ này → backend không cần cấu hình CORS khi dev.
VITE_API_URL=http://localhost:8081
